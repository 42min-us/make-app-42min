{
  "name": "update keeps what it should",
  "flow": [
    { "module": "listEventTypes", "mapper": { "limit": 1, "active": true } },
    { "module": "listSlots", "mapper": { "identify_by": "id", "event_type_id": "{{1.id}}", "start": "{{addDays(now, 1)}}", "end": "{{addDays(now, 7)}}", "limit": 1 } },
    { "module": "createBooking", "mapper": {
        "identify_by": "id", "event_type_id": "{{1.id}}", "start": "{{2.start}}",
        "attendee_email": "dev.test.user+make@42min.us", "attendee_name": "Before update",
        "metadata": [{ "key": "kept", "value": "yes" }] } },
    { "module": "updateBooking", "mapper": { "uid": "{{3.uid}}", "attendee_name": "After update", "metadata": [{ "key": "added", "value": "yes" }] } },
    { "module": "getBooking", "mapper": { "uid": "{{3.uid}}" },
      "filter": { "name": "renamed, metadata merged, still confirmed", "conditions": [[
        { "a": "{{4.attendees[1].name}}", "b": "After update", "o": "text:equal" },
        { "a": "{{4.metadata.kept}}", "b": "yes", "o": "text:equal" },
        { "a": "{{4.metadata.added}}", "b": "yes", "o": "text:equal" },
        { "a": "{{4.status}}", "b": "confirmed", "o": "text:equal" } ]] } },
    { "module": "cancelBooking", "mapper": { "uid": "{{3.uid}}", "reason": "Automated test of the Make app" },
      "filter": { "name": "get returned the same booking", "conditions": [[
        { "a": "{{5.uid}}", "b": "{{3.uid}}", "o": "text:equal" } ]] } }
  ]
}
