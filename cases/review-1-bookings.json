{
  "name": "review 1, booking lifecycle",
  "flow": [
    {
      "module": "getCurrentUser",
      "mapper": {}
    },
    {
      "module": "listEventTypes",
      "mapper": {
        "limit": 1,
        "active": true
      }
    },
    {
      "module": "getEventType",
      "mapper": {
        "identify_by": "id",
        "event_type_id": "{{2.id}}"
      }
    },
    {
      "module": "listSlots",
      "mapper": {
        "identify_by": "id",
        "event_type_id": "{{2.id}}",
        "start": "{{addDays(now, 1)}}",
        "end": "{{addDays(now, 4)}}",
        "limit": 1
      }
    },
    {
      "module": "checkSlot",
      "mapper": {
        "identify_by": "id",
        "event_type_id": "{{2.id}}",
        "start": "{{4.start}}"
      }
    },
    {
      "module": "createBooking",
      "mapper": {
        "identify_by": "id",
        "event_type_id": "{{2.id}}",
        "start": "{{4.start}}",
        "attendee_email": "dev.test.user+make@42min.us",
        "attendee_name": "Make review test",
        "metadata": [
          {
            "key": "source",
            "value": "make-review-test"
          }
        ]
      },
      "filter": {
        "name": "the slot is bookable",
        "conditions": [
          [
            {
              "a": "{{5.available}}",
              "b": "true",
              "o": "text:equal"
            }
          ]
        ]
      }
    },
    {
      "module": "getBooking",
      "mapper": {
        "uid": "{{6.uid}}"
      }
    },
    {
      "module": "updateBooking",
      "mapper": {
        "uid": "{{6.uid}}",
        "attendee_name": "Make review test, renamed"
      }
    },
    {
      "module": "listSlots",
      "mapper": {
        "identify_by": "id",
        "event_type_id": "{{2.id}}",
        "start": "{{addDays(now, 8)}}",
        "end": "{{addDays(now, 11)}}",
        "limit": 1
      }
    },
    {
      "module": "rescheduleBooking",
      "mapper": {
        "uid": "{{6.uid}}",
        "start": "{{9.start}}",
        "reason": "Automated test"
      }
    },
    {
      "module": "cancelBooking",
      "mapper": {
        "uid": "{{10.uid}}",
        "reason": "Automated test cleanup"
      }
    }
  ]
}